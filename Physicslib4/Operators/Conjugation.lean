import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Algebra.Star.Subalgebra
import Mathlib.Algebra.Group.Center
import Mathlib.Tactic.NoncommRing
import Mathlib.Analysis.Normed.Algebra.Exponential

/-!
# Conjugation by a unit and by a unitary

Spacetime-agnostic operator-algebra machinery used by the geometric-covariance
results of algebraic QFT (both the Minkowski and curved Haag-Kastler nets), kept
here so neither net depends on the other.

* `Units.conjMulEquiv u` — conjugation by a monoid unit, `x ↦ u x u⁻¹`, as a
  multiplicative automorphism.
* `MulEquiv.image_centralizer` / `image_centralizer_centralizer` — a multiplicative
  automorphism maps centralizers (hence bicommutants) to those of the image.
* `Physicslib4.lieConj U` — conjugation by a unitary `U : H ≃ₗᵢ[ℂ] H` on `B(H)`,
  with `lieConj_apply` and the bridge `lieConj_apply_eq_conjStarAlgEquiv` to
  Mathlib's `LinearIsometryEquiv.conjStarAlgEquiv`. Its algebra/metric structure is
  recorded by `lieConj_one`, `lieConj_add`, `lieConj_smul`, `lieConj_star`, `exp_lieConj`,
  and the norm preservation `norm_lieConj`.
* `Physicslib4.scalarOperators` / `IsFactor` and `IsFactor.conj` — the factor
  (trivial-center) property and its preservation under conjugation.
* `Physicslib4.restrictStarAlgEquiv` — a `*`-automorphism carrying one
  star-subalgebra's set onto another's restricts to a `*`-algebra equivalence.
-/

namespace Units

variable {M : Type*} [Monoid M]

/--
Conjugation x ↦ u x u⁻¹ by an invertible element u of a monoid, as a multiplicative
automorphism.

It preserves products, (u x u⁻¹)(u y u⁻¹) = u (xy) u⁻¹, and its inverse is conjugation by u⁻¹.
In operator algebra u is an invertible operator, typically a unitary implementing a symmetry,
and the automorphism is the induced change of frame on observables, A ↦ u A u⁻¹.

Implementation note: u is a `Units` element, so u⁻¹ is a genuine two-sided inverse. Only the
multiplicative structure is recorded; `lieConj` specialises this to unitaries on a Hilbert space.

Blueprint: def:unitary-conjugation
-/
def conjMulEquiv (u : Mˣ) : M ≃* M where
  toFun x := ↑u * x * ↑u⁻¹
  invFun x := ↑u⁻¹ * x * ↑u
  left_inv x := by
    calc (↑u⁻¹ : M) * (↑u * x * ↑u⁻¹) * ↑u
        = (↑u⁻¹ * ↑u) * x * (↑u⁻¹ * ↑u) := by noncomm_ring
      _ = x := by rw [u.inv_mul]; noncomm_ring
  right_inv x := by
    calc (↑u : M) * (↑u⁻¹ * x * ↑u) * ↑u⁻¹
        = (↑u * ↑u⁻¹) * x * (↑u * ↑u⁻¹) := by noncomm_ring
      _ = x := by rw [u.mul_inv]; noncomm_ring
  map_mul' x y := by
    calc (↑u : M) * (x * y) * ↑u⁻¹
        = ↑u * x * (↑u⁻¹ * ↑u) * y * ↑u⁻¹ := by rw [u.inv_mul]; noncomm_ring
      _ = (↑u * x * ↑u⁻¹) * (↑u * y * ↑u⁻¹) := by noncomm_ring

@[simp] theorem conjMulEquiv_apply (u : Mˣ) (x : M) :
    conjMulEquiv u x = ↑u * x * ↑u⁻¹ := rfl

end Units

namespace MulEquiv

variable {M : Type*} [Mul M]

/--
A multiplicative automorphism φ maps the centralizer of a set S onto the centralizer of φ(S).

The centralizer, or commutant, S' is the set of elements commuting with every element of S. An
element commutes with every s ∈ S exactly when its image commutes with every φ(s), so
φ(S') = φ(S)'. This is the algebraic fact behind geometric covariance of the local von Neumann
algebras: conjugation by a unitary commutes with taking commutants.

Implementation note: the centralizer is Mathlib's `Set.centralizer`, and only multiplication is
used, so the statement holds in any `Mul` structure.

Blueprint: lmm:automorphism-commutant
-/
theorem image_centralizer (φ : M ≃* M) (S : Set M) :
    φ '' Set.centralizer S = Set.centralizer (φ '' S) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨x, hx, rfl⟩
    rw [Set.mem_centralizer_iff]
    rintro _ ⟨s, hs, rfl⟩
    rw [← map_mul, ← map_mul]
    exact congrArg φ (Set.mem_centralizer_iff.mp hx s hs)
  · intro y hy
    refine ⟨φ.symm y, ?_, φ.apply_symm_apply y⟩
    rw [Set.mem_centralizer_iff]
    intro s hs
    apply φ.injective
    rw [map_mul, map_mul, φ.apply_symm_apply]
    exact Set.mem_centralizer_iff.mp hy (φ s) ⟨s, hs, rfl⟩

/--
A multiplicative automorphism φ maps the bicommutant S'' of a set onto the bicommutant of φ(S).

This is `image_centralizer` applied twice. For a set S of bounded operators closed under
adjoints, S'' is the von Neumann algebra generated by S and 𝟙 (by von Neumann's
bicommutant theorem), so conjugation by a unitary U carries the von Neumann algebra generated by
S onto the one generated by U S U⁻¹. Through this lemma the local von Neumann algebras R(B) inherit
geometric covariance from the net.

Implementation note: the bicommutant is `Set.centralizer (Set.centralizer S)`; the lemma does
not use the bicommutant theorem.

Blueprint: lmm:automorphism-commutant
-/
theorem image_centralizer_centralizer (φ : M ≃* M) (S : Set M) :
    φ '' Set.centralizer (Set.centralizer S)
      = Set.centralizer (Set.centralizer (φ '' S)) := by
  rw [φ.image_centralizer, φ.image_centralizer]

end MulEquiv

namespace Physicslib4

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/--
Conjugation T ↦ U T U⁻¹ by a unitary U, as a multiplicative automorphism of the bounded
operators on H.

If a symmetry acts on state vectors by U, it acts on observables by T ↦ U T U⁻¹; this is how a
unitary representation of the Poincaré group, or of a group of isometries, moves the local
algebras of a net. The map preserves products, sums, scalar multiples, adjoints and the
operator norm (`lieConj_add`, `lieConj_smul`, `lieConj_star`, `norm_lieConj`), and commutes with
the exponential (`exp_lieConj`).

Implementation note: the unitary is `H ≃ₗᵢ[ℂ] H` and the map is `Units.conjMulEquiv` of the
corresponding unit of `H →L[ℂ] H`, so only the multiplicative structure is in the type. The
pointwise formula is `lieConj_apply`, and `lieConj_apply_eq_conjStarAlgEquiv` identifies it with
Mathlib's `*`-algebra automorphism `LinearIsometryEquiv.conjStarAlgEquiv`.

Blueprint: def:unitary-conjugation
-/
noncomputable def lieConj (Uop : H ≃ₗᵢ[ℂ] H) : (H →L[ℂ] H) ≃* (H →L[ℂ] H) :=
  Units.conjMulEquiv (Uop.toContinuousLinearEquiv.toUnit)

omit [CompleteSpace H] in
@[simp] theorem lieConj_apply (Uop : H ≃ₗᵢ[ℂ] H) (T : H →L[ℂ] H) (x : H) :
    lieConj Uop T x = Uop (T (Uop.symm x)) := by
  change ((Uop.toContinuousLinearEquiv : H →L[ℂ] H) * T
        * (Uop.toContinuousLinearEquiv.symm : H →L[ℂ] H)) x = Uop (T (Uop.symm x))
  simp only [mul_apply_eq_comp, ContinuousLinearEquiv.coe_coe,
    LinearIsometryEquiv.coe_toContinuousLinearEquiv]
  rfl

/--
Conjugation by a unitary commutes with the exponential: exp(W A W⁻¹) = W exp(A) W⁻¹ for every
bounded operator A.

Each term of the exponential series satisfies (W A W⁻¹)ⁿ = W Aⁿ W⁻¹, and conjugation is
continuous. With A = itP and `lieConj_smul` it gives exp(it W P W⁻¹) = W exp(itP) W⁻¹: the
conjugate of the unitary group generated by a bounded P is the group generated by W P W⁻¹.

Implementation note: the exponential is Mathlib's `NormedSpace.exp`, and the proof is
`NormedSpace.exp_units_conj`, since `lieConj W` is conjugation by the unit W. The series
converges because H is complete.

Blueprint: def:unitary-conjugation
-/
theorem exp_lieConj (W : H ≃ₗᵢ[ℂ] H) (A : H →L[ℂ] H) :
    NormedSpace.exp (lieConj W A) = lieConj W (NormedSpace.exp A) := by
  haveI : NormedAlgebra ℚ (H →L[ℂ] H) :=
    NormedAlgebra.restrictScalars ℚ ℂ (H →L[ℂ] H)
  simp only [lieConj, Units.conjMulEquiv_apply]
  exact NormedSpace.exp_units_conj _ A

omit [CompleteSpace H] in
/-- Conjugation by a unitary is `ℂ`-linear: `lieConj W (c • A) = c • lieConj W A`. -/
theorem lieConj_smul (W : H ≃ₗᵢ[ℂ] H) (c : ℂ) (A : H →L[ℂ] H) :
    lieConj W (c • A) = c • lieConj W A := by
  simp only [lieConj, Units.conjMulEquiv_apply, mul_smul_comm, smul_mul_assoc]

omit [CompleteSpace H] in
/-- Conjugation by a unitary fixes the identity: `lieConj W 1 = 1`. -/
@[simp] theorem lieConj_one (W : H ≃ₗᵢ[ℂ] H) : lieConj W (1 : H →L[ℂ] H) = 1 :=
  map_one (lieConj W)

omit [CompleteSpace H] in
/-- Conjugation by a unitary is additive: `lieConj W (A + B) = lieConj W A + lieConj W B`. -/
theorem lieConj_add (W : H ≃ₗᵢ[ℂ] H) (A B : H →L[ℂ] H) :
    lieConj W (A + B) = lieConj W A + lieConj W B := by
  simp only [lieConj, Units.conjMulEquiv_apply, mul_add, add_mul]

/--
The scalar operators on H: the multiples c𝟙 of the identity, c ∈ ℂ.

They commute with every operator, so they lie in the center of every algebra that contains them.
An algebra whose center is exactly the scalars is a factor (`IsFactor`). For an irreducible
representation the commutant of its image is ℂ𝟙 itself (Schur's lemma).

Implementation note: the set is `{T | ∃ c : ℂ, T = c • 1}` in `H →L[ℂ] H`, and needs no
completeness of H.

Blueprint: def:factor
-/
def scalarOperators (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :
    Set (H →L[ℂ] H) :=
  {T : H →L[ℂ] H | ∃ c : ℂ, T = c • 1}

/--
A set R of bounded operators is a factor when its center R ∩ R' is exactly the scalar
operators.

Here R' is the commutant, the operators commuting with every element of R. For a von Neumann
algebra this is the usual notion of a factor: it cannot be split as a direct sum of two smaller
von Neumann algebras by a central projection. In algebraic quantum field theory the local
algebras R(B) of many models are factors. The library proves that this property is preserved by
unitary conjugation (`IsFactor.conj`), hence constant along the orbit of a region under the
symmetry group (`HaagKastlerNet.localVonNeumann_isFactor_smul`), and relates it to irreducible
inclusions (`HaagKastlerNet.isFactor_of_isIrreducibleInclusion`).

Implementation note: the definition applies to any set of operators, not only to von Neumann
algebras, with the commutant given by `Set.centralizer`; since the center must equal the
scalars, a factor contains 𝟙.

Blueprint: def:factor
-/
def IsFactor (R : Set (H →L[ℂ] H)) : Prop :=
  R ∩ Set.centralizer R = scalarOperators H

omit [CompleteSpace H] in
/-- Conjugation by a unitary fixes the scalar operators setwise:
`U (c · 1) U⁻¹ = c · 1`. -/
theorem lieConj_image_scalarOperators (Uop : H ≃ₗᵢ[ℂ] H) :
    lieConj Uop '' scalarOperators H = scalarOperators H := by
  have hfix : ∀ c : ℂ, lieConj Uop (c • (1 : H →L[ℂ] H)) = c • 1 := by
    intro c
    ext x
    rw [lieConj_apply]
    simp
  ext T
  simp only [scalarOperators, Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨_, ⟨c, rfl⟩, rfl⟩
    exact ⟨c, hfix c⟩
  · rintro ⟨c, rfl⟩
    exact ⟨c • (1 : H →L[ℂ] H), ⟨c, rfl⟩, hfix c⟩

omit [CompleteSpace H] in
/--
If R is a factor and U is unitary, then U R U⁻¹ is a factor.

Conjugation by U is a multiplicative bijection, so it carries the center R ∩ R' onto the center
of U R U⁻¹ (`MulEquiv.image_centralizer`), and it fixes every scalar operator,
U (c𝟙) U⁻¹ = c𝟙. Combined with geometric covariance, R(L·B) = U(L) R(B) U(L)⁻¹, this shows that
being a factor is constant along the orbit of a region under the symmetry group.

Implementation note: U R U⁻¹ is the image `lieConj Uop '' R`, and H need not be complete.

Blueprint: lmm:factor-conj
-/
theorem IsFactor.conj (Uop : H ≃ₗᵢ[ℂ] H) {R : Set (H →L[ℂ] H)} (h : IsFactor R) :
    IsFactor (lieConj Uop '' R) := by
  unfold IsFactor at h ⊢
  rw [← (lieConj Uop).image_centralizer R, ← Set.image_inter (lieConj Uop).injective, h,
    lieConj_image_scalarOperators]

/--
Conjugation by a unitary U, `lieConj U`, agrees on every operator with Mathlib's conjugation
`*`-algebra automorphism `LinearIsometryEquiv.conjStarAlgEquiv U`.

Both send T to U T U⁻¹. The point is that the second is a `*`-algebra automorphism, so the
equation transfers preservation of adjoints to `lieConj U` (`lieConj_star`), and lets the local
algebras of a net be moved by a `*`-algebra equivalence (`restrictStarAlgEquiv`).

Implementation note: `lieConj U` is only a `MulEquiv`; this lemma is the bridge to the
`StarAlgEquiv`, used, for example, in `lieConj_star`.

Blueprint: def:unitary-conjugation
-/
theorem lieConj_apply_eq_conjStarAlgEquiv (Uop : H ≃ₗᵢ[ℂ] H) (T : H →L[ℂ] H) :
    lieConj Uop T = LinearIsometryEquiv.conjStarAlgEquiv Uop T := by
  ext x
  rw [lieConj_apply, LinearIsometryEquiv.conjStarAlgEquiv_apply]
  simp [ContinuousLinearMap.comp_apply]

/-- Conjugation by a unitary is `star`-preserving: `lieConj W (star A) = star (lieConj W A)`.
It agrees with Mathlib's conjugation `*`-automorphism, which preserves the adjoint. -/
theorem lieConj_star (W : H ≃ₗᵢ[ℂ] H) (A : H →L[ℂ] H) :
    lieConj W (star A) = star (lieConj W A) := by
  rw [lieConj_apply_eq_conjStarAlgEquiv, lieConj_apply_eq_conjStarAlgEquiv]
  exact map_star _ A

omit [CompleteSpace H] in
/--
Conjugation by a unitary preserves the operator norm: ‖W A W⁻¹‖ = ‖A‖.

Since W and W⁻¹ are isometries, ‖W A W⁻¹ ψ‖ = ‖A W⁻¹ψ‖ ≤ ‖A‖ ‖ψ‖, and the reverse inequality
follows in the same way from A = W⁻¹ (W A W⁻¹) W. So conjugation is an isometric automorphism
of the C\*-algebra of bounded operators.

Implementation note: both inequalities are proved by `ContinuousLinearMap.opNorm_le_bound`, and
H need not be complete.

Blueprint: def:unitary-conjugation
-/
theorem norm_lieConj (W : H ≃ₗᵢ[ℂ] H) (A : H →L[ℂ] H) :
    ‖lieConj W A‖ = ‖A‖ := by
  refine le_antisymm (ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg A) fun x => ?_)
    (ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun x => ?_)
  · rw [lieConj_apply, W.norm_map]
    calc ‖A (W.symm x)‖ ≤ ‖A‖ * ‖W.symm x‖ := A.le_opNorm _
      _ = ‖A‖ * ‖x‖ := by rw [W.symm.norm_map]
  · have hx : A x = W.symm (lieConj W A (W x)) := by simp [lieConj_apply]
    rw [hx, W.symm.norm_map]
    calc ‖lieConj W A (W x)‖ ≤ ‖lieConj W A‖ * ‖W x‖ := (lieConj W A).le_opNorm _
      _ = ‖lieConj W A‖ * ‖x‖ := by rw [W.norm_map]

/--
A `*`-algebra automorphism e that maps a `*`-subalgebra S into T, and whose inverse maps T into
S, restricts to a `*`-algebra isomorphism from S onto T.

This is how a symmetry acts between local algebras: conjugation by the unitary U(L) is a
`*`-automorphism of the bounded operators that carries the local von Neumann algebra R(B) onto
R(L·B), and so gives a `*`-isomorphism between the two (`HaagKastlerNet.localVonNeumannEquiv`).

Implementation note: the two inclusion hypotheses `hfwd` and `hbwd` make the restriction and its
inverse well defined; `@[simps! apply]` generates the lemma that the restriction acts as e.

Blueprint: lmm:restrict-star-alg-equiv
-/
@[simps! apply]
def restrictStarAlgEquiv {A : Type*} [Ring A] [StarRing A] [Algebra ℂ A] [StarModule ℂ A]
    (e : A ≃⋆ₐ[ℂ] A) {S T : StarSubalgebra ℂ A}
    (hfwd : ∀ x ∈ S, e x ∈ T) (hbwd : ∀ y ∈ T, e.symm y ∈ S) : S ≃⋆ₐ[ℂ] T where
  toFun x := ⟨e x, hfwd x x.2⟩
  invFun y := ⟨e.symm y, hbwd y y.2⟩
  left_inv x := Subtype.ext (by simp)
  right_inv y := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)
  map_smul' r x := Subtype.ext (by simp)
  map_star' x := Subtype.ext (map_star e _)

end Physicslib4
