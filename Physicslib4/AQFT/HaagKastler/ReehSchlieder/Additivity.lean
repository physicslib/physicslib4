import Physicslib4.AQFT.HaagKastler.ReehSchlieder.Correlations
import Physicslib4.AQFT.HaagKastler.LocalVonNeumann
import Physicslib4.Operators.DensityTheorem

/-!
# Weak additivity and the Reeh–Schlieder theorem

For a diamond `B`, the translation-generated algebra `𝔄_B` is the norm closure of the
`*`-subalgebra of the quasilocal algebra `𝔘` generated by the translates
`ι_{B + x}(𝔘(B + x))`, `x ∈ ℝ⁴`, where `B + x = translationSub x • B`. The net is weakly additive
when `𝔄_B = 𝔘` for every nonempty diamond `B`.

The covariant setting is that of `Correlations.lean`: a `*`-representation `π` of `𝔘` on `H`, a
vector `Ω`, unitaries `U(x)` indexed by `ℝ⁴` with `U(x)π(a)Ω = π(β_x a)Ω`, and positive energy of
every future-timelike translation subgroup `t ↦ U(t n)`. A vector `Ω` is cyclic for a set `S` of
operators when `{T Ω | T ∈ S}` is dense; for the local algebra this is
`Dense ((fun T => T Ω) '' N.localOperators π hB)`, and for `π(𝔄_B)` it is
`Dense (Set.range fun a : N.translationGeneratedAlgebra hB => π a Ω)`. The commutant is
`Set.centralizer` in `H →L[ℂ] H`, as in `LocalVonNeumann.lean`.

* `HaagKastlerNet.translationGeneratedAlgebra` — the algebra `𝔄_B`.
* `HaagKastlerNet.IsWeaklyAdditive` — weak additivity.
* `HaagKastlerNet.IsWeaklyAdditiveVonNeumann` — weak additivity in the von Neumann sense.
* `reeh_schlieder` — `π(𝔄_{B₁})Ω` lies in the closure of `π(𝔘(B))Ω`.
* `reeh_schlieder_cyclic`, `reeh_schlieder_cyclic_of_vonNeumann`,
  `reeh_schlieder_cyclic_of_weaklyAdditive`, `reeh_schlieder_cyclic_of_vacuum`,
  `reeh_schlieder_separating` — the corollaries.
-/

namespace Physicslib4
namespace AQFT
namespace HaagKastler

open scoped InnerProductSpace Pointwise
open Spacetime

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The translation-generated algebra `𝔄_B` of a diamond `B`: the C*-subalgebra of the
quasilocal algebra generated by the translates `ι_{B + x}(𝔘(B + x))`, `x ∈ ℝ⁴`, that is, the norm
closure of the `*`-subalgebra they generate. Here `B + x = translationSub x • B`.

Blueprint: def:translation-generated-algebra -/
noncomputable def HaagKastlerNet.translationGeneratedAlgebra (N : HaagKastlerNet)
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B) :
    StarSubalgebra ℂ N.quasilocal.carrier :=
  StarSubalgebra.topologicalClosure <| StarAlgebra.adjoin ℂ <|
    ⋃ x : StandardMinkowskiSpacetime.Carrier,
      Set.range (N.quasilocal.ι (isAlexandrovBasisSet_smul (translationSub x) hB))

/-- A Haag–Kastler net is weakly additive if the translation-generated algebra `𝔄_B` is the
whole quasilocal algebra for every nonempty diamond `B`.

Blueprint: def:weak-additivity -/
def HaagKastlerNet.IsWeaklyAdditive (N : HaagKastlerNet) : Prop :=
  ∀ ⦃B : Set StandardMinkowskiSpacetime.Carrier⦄ (hB : IsAlexandrovBasisSet B), B.Nonempty →
    N.translationGeneratedAlgebra hB = ⊤

/-- A `*`-representation `π` of the quasilocal algebra satisfies weak additivity in the von
Neumann sense if `π(𝔘) ⊆ π(𝔄_B)''` for every nonempty diamond `B`, the commutant being taken in
the bounded operators on `H` (`Set.centralizer`).

Blueprint: def:weak-additivity-von-neumann -/
def HaagKastlerNet.IsWeaklyAdditiveVonNeumann (N : HaagKastlerNet)
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) : Prop :=
  ∀ ⦃B : Set StandardMinkowskiSpacetime.Carrier⦄ (hB : IsAlexandrovBasisSet B), B.Nonempty →
    Set.range π ⊆
      Set.centralizer (Set.centralizer (Set.range fun a : N.translationGeneratedAlgebra hB => π a))

/-- If the net is weakly additive, every `*`-representation of the quasilocal algebra satisfies
weak additivity in the von Neumann sense.

Blueprint: lmm:weak-additivity-von-neumann -/
theorem HaagKastlerNet.IsWeaklyAdditive.isWeaklyAdditiveVonNeumann {N : HaagKastlerNet}
    (hN : N.IsWeaklyAdditive) (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) :
    N.IsWeaklyAdditiveVonNeumann π := by
  intro B hB hne
  refine subset_trans ?_ Set.subset_centralizer_centralizer
  rintro _ ⟨c, rfl⟩
  exact ⟨⟨c, by rw [hN hB hne]; trivial⟩, rfl⟩

/-- **Orthogonality on the generated `*`-algebra.** In the setting of
`inner_translated_products_eq_zero`, `ψ` is orthogonal to `π(P)Ω` for every `P` in the
`*`-algebra generated by the translates `ι_{B₁ + y}(𝔘(B₁ + y))`, `y ∈ ℝ⁴`.

The binder groups are the covariant setting (`π`, `Ω`, `U`, `hU`), positive energy (`hpos`), the
diamonds with the translation condition (`hB₁`, `hB`, `hB₁B`), and the vector `ψ` with its
orthogonality `hψ`.

Blueprint: lmm:reeh-schlieder-star-algebra-orthogonal -/
theorem inner_adjoin_translates_eq_zero {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    {B₁ B : Set StandardMinkowskiSpacetime.Carrier}
    (hB₁ : IsAlexandrovBasisSet B₁) (hB : IsAlexandrovBasisSet B)
    (hB₁B : ∀ᶠ x in nhds 0, translationSub x • B₁ ⊆ B)
    {ψ : H} (hψ : ∀ b : N.U.algebra B, ⟪ψ, π (N.quasilocal.ι hB b) Ω⟫_ℂ = 0) :
    ∀ P ∈ StarAlgebra.adjoin ℂ
        (⋃ y : StandardMinkowskiSpacetime.Carrier,
          Set.range (N.quasilocal.ι (isAlexandrovBasisSet_smul (translationSub y) hB₁))),
      ⟪ψ, π P Ω⟫_ℂ = 0 := by
  set S := ⋃ y : StandardMinkowskiSpacetime.Carrier,
    Set.range (N.quasilocal.ι (isAlexandrovBasisSet_smul (translationSub y) hB₁)) with hS
  have hstar : star S ⊆ S := by
    intro x hx
    obtain ⟨y, b, hb⟩ := Set.mem_iUnion.1 (Set.mem_star.1 hx)
    exact Set.mem_iUnion.2 ⟨y, star b, by rw [map_star, hb, star_star]⟩
  have hgen : ∀ g ∈ S, ∃ y a, N.action (translationSub y) (N.quasilocal.ι hB₁ a) = g := by
    intro g hg
    obtain ⟨y, hy⟩ := Set.mem_iUnion.1 hg
    rw [← (action_translationSub_image_range_ι N hB₁ hB y).1] at hy
    obtain ⟨_, ⟨a, rfl⟩, h⟩ := hy
    exact ⟨y, a, h⟩
  have hmon : ∀ m ∈ Submonoid.closure S, ⟪ψ, π m Ω⟫_ℂ = 0 := by
    intro m hm
    obtain ⟨l, hl, rfl⟩ := Submonoid.exists_list_of_mem_closure hm
    choose y a hya using fun i : Fin l.length => hgen _ (hl _ (List.get_mem l i))
    have : l = List.ofFn fun i => N.action (translationSub (y i)) (N.quasilocal.ι hB₁ (a i)) := by
      conv_lhs => rw [← List.ofFn_get l]
      exact congrArg _ (funext fun i => (hya i).symm)
    rw [this]
    exact inner_monomial_eq_zero π Ω U hU hpos hB₁ hB hB₁B hψ a y
  intro P hP
  have hP' : P ∈ Subalgebra.toSubmodule (Algebra.adjoin ℂ S) := by
    have h : P ∈ (StarAlgebra.adjoin ℂ S).toSubalgebra := hP
    rwa [StarAlgebra.adjoin_toSubalgebra, Set.union_eq_left.2 hstar] at h
  rw [Algebra.adjoin_eq_span] at hP'
  clear hP
  induction hP' using Submodule.span_induction with
  | mem x hx => exact hmon x hx
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, add_apply, inner_add_right, hx, hy, add_zero]
  | smul c x _ hx => rw [map_smul, smul_apply, inner_smul_right, hx, mul_zero]

/-- **Bicommutant orbit closure.** For a `*`-representation `π` of the quasilocal algebra on `H`,
`Ω ∈ H` and a diamond `B`, every `T ∈ π(𝔄_B)''` maps `Ω` into the closure of `π(𝔄_B)Ω`. This is
`apply_mem_closure_of_mem_bicommutant` for the restriction of `π` to `𝔄_B`.

Blueprint: lmm:bicommutant-orbit-closure -/
theorem apply_mem_closure_translationGeneratedAlgebra {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B) {T : H →L[ℂ] H}
    (hT : T ∈ Set.centralizer
      (Set.centralizer (Set.range fun a : N.translationGeneratedAlgebra hB => π a))) :
    T Ω ∈ closure (Set.range fun a : N.translationGeneratedAlgebra hB => π a Ω) := by
  exact apply_mem_closure_of_mem_bicommutant (π.comp (N.translationGeneratedAlgebra hB).subtype)
    (T := T) hT Ω

/-- **Reeh–Schlieder theorem.** Let `π` be a `*`-representation of the quasilocal algebra on `H`,
`Ω ∈ H`, and `U(x)` unitaries with `U(x)π(a)Ω = π(β_x a)Ω`, such that every future-timelike
translation subgroup `t ↦ U(t n)` has positive energy. Let `B₁, B` be diamonds with
`B₁ + x ⊆ B` for every `x` near `0`. Then `π(𝔄_{B₁})Ω` lies in the closure of `π(𝔘(B))Ω`.

The binder groups are the covariant setting (`π`, `Ω`, `U`, `hU`), positive energy (`hpos`), and
the diamonds with the translation condition (`hB₁`, `hB`, `hB₁B`).

Blueprint: thrm:reeh-schlieder -/
theorem reeh_schlieder {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    {B₁ B : Set StandardMinkowskiSpacetime.Carrier}
    (hB₁ : IsAlexandrovBasisSet B₁) (hB : IsAlexandrovBasisSet B)
    (hB₁B : ∀ᶠ x in nhds 0, translationSub x • B₁ ⊆ B) :
    ∀ A ∈ N.translationGeneratedAlgebra hB₁,
      π A Ω ∈ closure (Set.range fun b : N.U.algebra B => π (N.quasilocal.ι hB b) Ω) := by
  intro A hA
  let M : Submodule ℂ H := LinearMap.range
    ((ContinuousLinearMap.apply ℂ H Ω).toLinearMap ∘ₗ
      (π.comp (N.quasilocal.ι hB)).toAlgHom.toLinearMap)
  have hM : closure (Set.range fun b : N.U.algebra B => π (N.quasilocal.ι hB b) Ω) =
      (Mᗮᗮ : Set H) := by
    rw [Submodule.orthogonal_orthogonal_eq_closure, Submodule.topologicalClosure_coe]; rfl
  rw [hM]
  refine (Submodule.mem_orthogonal' _ _).2 fun ψ hψ => ?_
  have hψ' : ∀ b : N.U.algebra B, ⟪ψ, π (N.quasilocal.ι hB b) Ω⟫_ℂ = 0 := fun b =>
    (Submodule.mem_orthogonal' _ _).1 hψ _ ⟨b, rfl⟩
  have := NonUnitalStarAlgHom.instContinuousLinearMapClassComplex
    (F := N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H))
  have hcl : IsClosed {P : N.quasilocal.carrier | ⟪ψ, π P Ω⟫_ℂ = 0} :=
    isClosed_eq (continuous_const.inner
      ((continuous_eval_const Ω).comp (map_continuous π))) continuous_const
  have hsub := closure_minimal (fun P hP => inner_adjoin_translates_eq_zero π Ω U hU hpos hB₁ hB
    hB₁B hψ' P hP) hcl
  have : A ∈ closure (StarAlgebra.adjoin ℂ (⋃ y : StandardMinkowskiSpacetime.Carrier,
      Set.range (N.quasilocal.ι (isAlexandrovBasisSet_smul (translationSub y) hB₁))) :
        Set N.quasilocal.carrier) := by
    rw [← StarSubalgebra.topologicalClosure_coe]; exact hA
  exact inner_eq_zero_symm.1 (hsub this)

/-- **Reeh–Schlieder, cyclic form.** In the setting of `reeh_schlieder`, if `Ω` is cyclic for
`π(𝔄_{B'})` for every nonempty diamond `B'`, then `Ω` is cyclic for `π(𝔘(B))` for every nonempty
diamond `B`.

The binder groups are the covariant setting (`π`, `Ω`, `U`, `hU`), positive energy (`hpos`), the
cyclicity hypothesis `hcyc`, and the nonempty diamond (`hB`, `hne`).

Blueprint: crllr:reeh-schlieder-cyclic -/
theorem reeh_schlieder_cyclic {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    (hcyc : ∀ ⦃B' : Set StandardMinkowskiSpacetime.Carrier⦄ (hB' : IsAlexandrovBasisSet B'),
      B'.Nonempty → Dense (Set.range fun a : N.translationGeneratedAlgebra hB' => π a Ω))
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B)
    (hne : B.Nonempty) :
    Dense ((fun T => T Ω) '' N.localOperators π hB) := by
  obtain ⟨B₁, hB₁, hne₁, V, hV, h0, hVB⟩ := exists_diamond_translate_subset hB hne
  have key := reeh_schlieder π Ω U hU hpos hB₁ hB (Filter.eventually_of_mem (hV.mem_nhds h0) hVB)
  have himg : (fun T => T Ω) '' N.localOperators π hB =
      Set.range fun b : N.U.algebra B => π (N.quasilocal.ι hB b) Ω :=
    (Set.range_comp _ _).symm
  rw [himg, ← dense_closure]
  refine (hcyc hB₁ hne₁).mono ?_
  rintro _ ⟨a, rfl⟩
  exact key a a.2

/-- **Reeh–Schlieder under von Neumann weak additivity.** In the setting of `reeh_schlieder`, if
`π` satisfies weak additivity in the von Neumann sense and `Ω` is cyclic for `π(𝔘)`, then `Ω` is
cyclic for `π(𝔘(B))` for every nonempty diamond `B`.

Blueprint: crllr:reeh-schlieder-von-neumann -/
theorem reeh_schlieder_cyclic_of_vonNeumann {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    (hwa : N.IsWeaklyAdditiveVonNeumann π) (hcyc : GNS.IsCyclicVector π Ω)
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B)
    (hne : B.Nonempty) :
    Dense ((fun T => T Ω) '' N.localOperators π hB) := by
  refine reeh_schlieder_cyclic π Ω U hU hpos (fun B' hB' hne' => ?_) hB hne
  rw [← dense_closure]
  refine Dense.mono ?_ (hcyc : Dense (Set.range fun a => π a Ω))
  rintro _ ⟨c, rfl⟩
  exact apply_mem_closure_translationGeneratedAlgebra π Ω hB' (hwa hB' hne' ⟨c, rfl⟩)

/-- **Reeh–Schlieder under weak additivity.** In the setting of `reeh_schlieder`, if the net is
weakly additive and `Ω` is cyclic for `π(𝔘)`, then `Ω` is cyclic for `π(𝔘(B))` for every
nonempty diamond `B`.

Blueprint: crllr:reeh-schlieder-weak-additivity -/
theorem reeh_schlieder_cyclic_of_weaklyAdditive {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    (hwa : N.IsWeaklyAdditive) (hcyc : GNS.IsCyclicVector π Ω)
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B)
    (hne : B.Nonempty) :
    Dense ((fun T => T Ω) '' N.localOperators π hB) :=
  reeh_schlieder_cyclic_of_vonNeumann π Ω U hU hpos (hwa.isWeaklyAdditiveVonNeumann π) hcyc hB hne

/-- **Reeh–Schlieder for a vacuum state.** Let the net be weakly additive, and let `(π, Ω, U)`
satisfy the implementation and spectrum conditions of a vacuum state (`IsVacuumStateConcrete`): the
unitaries `U(L)` implement the Poincaré action on `π(𝔘)Ω`, and `t ↦ U(γ(t))` has positive energy
for every future-timelike translation subgroup `γ`. If `Ω` is cyclic for `π(𝔘)`, then `Ω` is
cyclic for `π(𝔘(B))` for every nonempty diamond `B`.

The hypotheses mirror the implementation and spectrum conjuncts of the existential in
`IsVacuumState`, so the statement applies to the witnessing data of every vacuum state; the state
itself and the condition that `π` reproduces it are not needed.

Blueprint: crllr:reeh-schlieder-vacuum -/
theorem reeh_schlieder_cyclic_of_vacuum {N : HaagKastlerNet} (hwa : N.IsWeaklyAdditive)
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : InhomogeneousLorentzGroup → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ (L : InhomogeneousLorentzGroup) (a : N.quasilocal.carrier),
      U L (π a Ω) = π (N.action L a) Ω)
    (hpos : ∀ γ : ℝ → InhomogeneousLorentzGroup,
      IsOneParameterSubgroup γ → IsFutureTimelikeTranslation γ →
        IsPositiveEnergy (fun t => U (γ t)))
    (hcyc : GNS.IsCyclicVector π Ω)
    {B : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B)
    (hne : B.Nonempty) :
    Dense ((fun T => T Ω) '' N.localOperators π hB) :=
  reeh_schlieder_cyclic_of_weaklyAdditive π Ω (fun x => U (translationSub x))
    (fun x a => hU (translationSub x) a)
    (fun n hn => hpos (translationFlow n) (isOneParameterSubgroup_translationFlow n) ⟨n, hn, rfl⟩)
    hwa hcyc hB hne

/-- **Reeh–Schlieder, separating form.** In the setting of `reeh_schlieder_cyclic`, `Ω` is
separating for the local von Neumann algebra `R(C)` of every diamond `C` completely spacelike to
some nonempty diamond `B`: every `R ∈ R(C)` with `R Ω = 0` is zero.

The binder groups are the covariant setting (`π`, `Ω`, `U`, `hU`), positive energy (`hpos`), the
cyclicity hypothesis `hcyc`, the nonempty diamond (`hB`, `hne`), the diamond `C` with its spacelike
separation (`hC`, `hs`), and the operator `R` with `hR`, `hRΩ`.

Blueprint: crllr:reeh-schlieder-separating -/
theorem reeh_schlieder_separating {N : HaagKastlerNet}
    (π : N.quasilocal.carrier →⋆ₐ[ℂ] (H →L[ℂ] H)) (Ω : H)
    (U : StandardMinkowskiSpacetime.Carrier → (H ≃ₗᵢ[ℂ] H))
    (hU : ∀ x a, U x (π a Ω) = π (N.action (translationSub x) a) Ω)
    (hpos : ∀ n : StandardMinkowskiSpacetime.Carrier,
      (n : SpacetimeModel) ∈ minkowskiForwardCone 0 → IsPositiveEnergy (fun t : ℝ => U (t • n)))
    (hcyc : ∀ ⦃B' : Set StandardMinkowskiSpacetime.Carrier⦄ (hB' : IsAlexandrovBasisSet B'),
      B'.Nonempty → Dense (Set.range fun a : N.translationGeneratedAlgebra hB' => π a Ω))
    {B C : Set StandardMinkowskiSpacetime.Carrier} (hB : IsAlexandrovBasisSet B)
    (hne : B.Nonempty) (hC : IsAlexandrovBasisSet C)
    (hs : Spacetime.IsCompletelySpacelike StandardMinkowskiSpacetime
      standardMinkowskiTimeOrientation B C)
    {R : H →L[ℂ] H} (hR : R ∈ N.localVonNeumannAlgebra π hC) (hRΩ : R Ω = 0) :
    R = 0 :=
  N.localVonNeumannAlgebra_separating π hB hC hs
    (reeh_schlieder_cyclic π Ω U hU hpos hcyc hB hne) hR hRΩ

