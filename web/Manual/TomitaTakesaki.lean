  (hC₂ : ∀ (x : H), C₂ (C₂ x) = x) :
  modularOperator M Ω C₁ = modularOperator M Ω C₂ ∧
    modularOperatorSqrt hM hΩ C₁ hC₁ = modularOperatorSqrt hM hΩ C₂ hC₂ ∧
